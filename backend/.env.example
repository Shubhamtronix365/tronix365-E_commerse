# Database Configuration
# Local SQLite fallback: sqlite:///./tronix365.db
# Neon PostgreSQL database URL for production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Brevo (Sendinblue) SMTP email configuration
BREVO_API_KEY=your_brevo_api_key_here
CONTACT_EMAIL=your_verified_sender_email@gmail.com

# PayU Credentials
PAYU_ENV=TEST
PAYU_KEY=your_payu_key_here
PAYU_SALT=your_payu_salt_here

# Security & CORS Settings
SECRET_KEY=generate_a_secure_random_key_here
CORS_ORIGINS=https://www.tronix365.in,https://tronix365.in,http://localhost:5173
FRONTEND_URL=https://www.tronix365.in/e-commerse
BACKEND_URL=https://tronix365-e-commerse.onrender.com

# Redis Cache (Optional - will fall back to InMemory Cache if connection fails)
REDIS_URL=redis://localhost:6379

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gemini AI Integration API Key
GEMINI_API_KEY=your_gemini_api_key_here
