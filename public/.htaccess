# ----------------------------------------------------------------------
# 1. Gzip / Deflate Compression (Reduces JS/CSS/HTML transfer size by up to 80%)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 2. Leverage Browser Caching (Expires headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Media
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Stylesheets & Scripts (Vite bundles are content-hashed)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML & JSON (Revalidate to ensure updates are delivered instantly)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# 3. HTTP Header Controls (Cache-Control & Security)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # 1-year immutable caching for fingerprinted assets
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|svg|woff2|woff|ttf|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML and PHP entrypoints must always be fresh
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security & MIME guards
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /e-commerse/

  # 1. Enforce HTTPS & www.tronix365.in
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?tronix365\.in$ [NC]
  RewriteRule ^(.*)$ https://www.tronix365.in/e-commerse/$1 [R=301,L]

  # 2. Redirect legacy /products routes to /product or /shop
  RewriteRule ^products/?$ /e-commerse/shop [R=301,L]
  RewriteRule ^products/(.+)$ /e-commerse/product/$1 [R=301,L]

  # 3. Strip trailing slash on sub-routes (e.g. /product/xyz/ -> /product/xyz)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /e-commerse/$1 [R=301,L]

  # 4. Route sitemap.xml to index.php for dynamic database-driven product mapping
  RewriteRule ^sitemap\.xml$ index.php [L]

  # 5. SPA routing to index.php
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /e-commerse/index.php [L]
</IfModule>
